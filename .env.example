# Copy to .env and replace every placeholder before deployment.
ENVIRONMENT=production
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://biometrics:replace-with-a-long-random-password@postgres:5432/biometrics
JWT_SECRET=replace-with-at-least-32-random-characters
BIOMETRIC_MASTER_KEY=replace-with-a-long-random-encryption-key
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8080
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
